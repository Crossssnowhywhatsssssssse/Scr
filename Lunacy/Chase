local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local function getGitImage(url,name)
	local file = name..".png"

	if getcustomasset and writefile and isfile then
		if not isfile(file) then
			writefile(file, game:HttpGet(url))
		end

		local asset = getcustomasset(file)

		task.spawn(function()
			task.wait(1)

			if delfile and isfile(file) then
				pcall(function()
					delfile(file)
				end)
			end
		end)

		return asset
	end

	return ""
end

local PARTICLE_TEXTURE = getGitImage(
	"https://raw.githubusercontent.com/Whatttt23/Scr/main/Kh%C3%B4ng%20C%C3%B3%20Ti%C3%AAu%20%C4%90%E1%BB%81244_20260606220200.png",
	"seek_particle"
)

local ActiveSeek = {}

local function HideObject(obj)
	if obj:IsA("BasePart") then
		obj.Transparency = 1

	elseif obj:IsA("Decal")
		or obj:IsA("Texture")
		or obj:IsA("ImageLabel")
		or obj:IsA("ImageButton") then

		obj.Transparency = 1
	end
end

local function GetHead(seek)
	for _,v in ipairs(seek:GetDescendants()) do
		if v:IsA("BasePart") and v.Name == "Head" then
			return v
		end
	end

	return nil
end

local function SetupSeek(seek)
	if ActiveSeek[seek] then
		return
	end

	local head = GetHead(seek)

	if not head then
		return
	end

	for _,v in ipairs(seek:GetDescendants()) do
		HideObject(v)
	end

	local part = Instance.new("Part")
	part.Name = "_SeekParticlePart"
	part.Size = Vector3.new(5,5,5)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Parent = Workspace

	local attachment = Instance.new("Attachment")
	attachment.Parent = part

	local emitter = Instance.new("ParticleEmitter")
	emitter.Parent = attachment
	emitter.Texture = PARTICLE_TEXTURE
	emitter.Enabled = true
	emitter.Rate = 5000
	emitter.Lifetime = NumberRange.new(0.1)
	emitter.Speed = NumberRange.new(0)
	emitter.Size = NumberSequence.new(5)
	emitter.Transparency = NumberSequence.new(0)
	emitter.LightEmission = 0
	emitter.Brightness = 0.5

	local hb
	hb = RunService.Heartbeat:Connect(function()
		if not seek.Parent or not head.Parent then
			hb:Disconnect()

			if part then
				part:Destroy()
			end

			ActiveSeek[seek] = nil
			return
		end

		part.CFrame = head.CFrame
	end)

	local addConn
	addConn = seek.DescendantAdded:Connect(function(obj)
		HideObject(obj)
	end)

	ActiveSeek[seek] = {
		Heartbeat = hb,
		Connection = addConn,
		Part = part
	}
end

task.spawn(function()
	while true do
		for _,obj in ipairs(Workspace:GetDescendants()) do
			if obj.Name == "SeekMovingNewClone" then
				SetupSeek(obj)

				for _,v in ipairs(obj:GetDescendants()) do
					HideObject(v)
				end
			end
		end

		task.wait(0.5)
	end
end)
