--------------------------------------------------
-- GET ROOM NODES
--------------------------------------------------

local function GetRoomNodes(room)

	local nodes = {}

	for _, v in ipairs(
		room:GetDescendants()
	) do

		if v:IsA("BasePart") then

			local num =
				tonumber(v.Name)

			if num
			and v.Parent
			and (
				v.Parent.Name == "PathfindNodes"
				or v.Parent.Name == "PathfindNode"
			) then

				table.insert(nodes,v)

			end
		end
	end

	table.sort(nodes,function(a,b)

		return
			tonumber(a.Name)
			<
			tonumber(b.Name)

	end)

	return nodes
end

--------------------------------------------------
-- MAIN PATH
--------------------------------------------------

local currentRoom = 1

while obj.Parent do

	local rooms = GetRooms()

	local roomData =
		rooms[currentRoom]

	if not roomData then

		local updated = false

		local connection

		connection =
			CurrentRooms.ChildAdded
			:Connect(function()
				updated = true
			end)

		local start = tick()

		while tick() - start < 1 do

			if updated then
				break
			end

			RunService.Heartbeat:Wait()
		end

		connection:Disconnect()

		if not updated then
			break
		end

		continue
	end

	local room = roomData.Room

	local nodes =
		GetRoomNodes(room)

	for _, node in ipairs(nodes) do

		if not obj.Parent then
			break
		end

		MoveTo(
			node.CFrame
			* CFrame.new(0,6,0)
		)
	end

	local exit =
		room:FindFirstChild(
			"RoomExit"
		)

	if exit then

		MoveTo(
			exit.CFrame
			* CFrame.new(0,3,0)
		)
	end

	currentRoom += 1

	RunService.Heartbeat:Wait()
end

