--------------------------------------------------
-- POSITION FUNCTIONS
--------------------------------------------------

local function GetCF()
	if obj:IsA("Model") then
		return obj:GetPivot()
	end

	return mainPart.CFrame
end

local function SetCF(cf)
	if not obj.Parent then
		return
	end

	if obj:IsA("Model") then
		obj:PivotTo(cf)
	else
		mainPart.CFrame = cf
	end
end

--------------------------------------------------
-- WALL CHECK
--------------------------------------------------

local function CanSeePlayer()
	local character = LocalPlayer.Character

	if not character then
		return false
	end

	local hrp =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not hrp then
		return false
	end

	local params = RaycastParams.new()
	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		obj,
		character
	}

	local result = workspace:Raycast(
		mainPart.Position,
		hrp.Position - mainPart.Position,
		params
	)

	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(character)
end

