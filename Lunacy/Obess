--------------------------------------------------
-- GET ROOMS
--------------------------------------------------

local function GetRooms()
	local rooms = {}

	for _, room in ipairs(CurrentRooms:GetChildren()) do
		local num = tonumber(room.Name)

		if num then
			table.insert(rooms,{
				Number = num,
				Room = room
			})
		end
	end

	table.sort(rooms,function(a,b)
		return a.Number < b.Number
	end)

	return rooms
end

local rooms = GetRooms()

