--------------------------------------------------
-- MOVE
--------------------------------------------------

local MoveSpeed = 50

local function MoveTo(targetCF)

	while obj.Parent do

		local currentCF = GetCF()

		local offset =
			targetCF.Position -
			currentCF.Position

		local distance =
			offset.Magnitude

		if distance <= 0.1 then
			SetCF(targetCF)
			break
		end

		local dt =
			RunService.Heartbeat:Wait()

		local step =
			MoveSpeed * dt

		if step >= distance then

			SetCF(targetCF)

			break

		else

			SetCF(
				currentCF:Lerp(
					targetCF,
					step / distance
				)
			)
		end
	end
end

