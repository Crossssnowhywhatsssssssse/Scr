function LoadCustomInstance(source, parent)
	local model
	local function NormalizeGitHubURL(url)
		if url:match("^https://github.com/.+%.rbxm$")
		and not url:find("?raw=true") then
			return url .. "?raw=true"
		end

		return url
	end

	local success, result = pcall(function()
		if tonumber(source) then
			return game:GetObjects(
				"rbxassetid://" .. tostring(source)
			)[1]

		elseif type(source) == "string"
		and source:match("^https?://")
		and source:match("%.rbxm") then

			local fileName =
				("temp_%s.rbxm"):format(
					math.random(100000,999999)
				)

			writefile(
				fileName,
				game:HttpGet(
					NormalizeGitHubURL(source)
				)
			)

			local obj = game:GetObjects(
				(getcustomasset or getsynasset)(fileName)
			)[1]

			pcall(function()
				delfile(fileName)
			end)

			return obj
		end
	end)

	if success then
		model = result
	end

	if not model then
		return nil
	end

	model.Parent = parent

	for _,v in ipairs(model:GetDescendants()) do
		if v:IsA("Script")
		or v:IsA("LocalScript") then
			v:Destroy()
		end
	end

	return model
end

