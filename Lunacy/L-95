local g95 = Spawner:Create({
	Entity = {
		Name = "The Lord",
		Asset = "rbxassetid://131036299867520",
		HeightOffset = 0
	},
	Lights = {
		Flicker = { Enabled = false, Duration = 1 },
		Shatter = true,
		Repair = false
	},
