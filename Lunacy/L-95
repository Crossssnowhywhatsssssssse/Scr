sound:Play()

g95:SetCallback("OnSpawned", function()
	repeat task.wait() until g95.Model

	task.spawn(function()
		while color do
			task.wait(3)
			local cc = clone
			if cc then
				TweenService:Create(
					cc,
					TweenInfo.new(1),
					{TintColor = Color3.fromRGB(math.random(100,255), 0, math.random(100,255))}
				):Play()
			end
		end
	end)

	task.spawn(function()
		for _,v in ipairs(g95.Model:GetDescendants()) do
			if v:IsA("Sound") and (v.Name == "Glitching Sound Effect 4" or v.Name == "scary_scream_glitch_V2") then
				v.PlaybackSpeed = 0.2
			end
		end
	end)
end)

g95:SetCallback("OnDespawning", function()
	color = false
	if sound then sound:Destroy() end

	task.wait(4)

	local cc = clone
	if cc then
		TweenService:Create(
			cc,
			TweenInfo.new(5),
			{TintColor = Color3.fromRGB(255,255,255)}
		):Play()
	end
	
	task.wait(5)
	cc:Destroy()
end)

g95:SetCallback("OnDamagePlayer", function(newHealth)
	if newHealth == 0 or newHealth < 0 then
		loadstring(game:HttpGet("https://pastefy.app/xclq6IqV/raw"))()
	end
end)

g95:Run(true)
