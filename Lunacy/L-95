local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

local color = true

local baseCC = Lighting:FindFirstChild("MainColorCorrection")
if not baseCC then return end

local clone = baseCC:Clone()
clone.Parent = Lighting

local sound = Instance.new("Sound")
sound.Name = "Thunder"
sound.SoundId = "rbxassetid://8068501155"
sound.Volume = 5
sound.Parent = workspace

Instance.new("PitchShiftSoundEffect", sound).Octave = 0.5
Instance.new("DistortionSoundEffect", sound).Level = 0.75

local Spawner =
loadstring(game:HttpGet(
"https://raw.githubusercontent.com/Whatttt23/Scr/main/New%20Spawner.txt"
))()

local entity = Spawner:Create({
	Entity = {
		Name = "The Lord",
		Asset = "rbxassetid://131036299867520",
		HeightOffset = 0
	},

	Lights = {
		Flicker = {Enabled=false},
		Shatter=true,
		Repair=false
	},

	Earthquake = {
		Enabled=true
	},

	CameraShake = {
		Enabled=true,
		Range=100,
		Values={10,10,0.1,0.2}
	},

	Movement = {
		Speed=700,
		Delay=8,
		Reversed=false
	},

	Rebounding = {
		Enabled=true,
		Type="Ambush",
		Min=8,
		Max=10,
		Delay=0.2
	},

	Damage = {
		Enabled=true,
		Range=100,
		Amount=999
	},

	Crucifixion = {
		Enabled=true,
		Range=999,
		Resist=true,
		Break=true
	},

	Death = {
		Type="Guiding",
		Hints={"."},
		Cause="L-95"
	}
})

sound:Play()

entity:SetCallback("OnSpawned",function()
	repeat task.wait() until entity.Model

	task.spawn(function()
		while color and clone.Parent do
			task.wait(3)

			TweenService:Create(
				clone,
				TweenInfo.new(1),
				{
					TintColor =
					Color3.fromRGB(
						math.random(100,255),
						0,
						math.random(100,255)
					)
				}
			):Play()
		end
	end)

	entity.Model.DescendantAdded:Connect(function(v)
		if v:IsA("Sound") then
			if v.Name=="Glitching Sound Effect 4"
			or v.Name=="scary_scream_glitch_V2"
			then
				v.PlaybackSpeed=0.2
			end
		end
	end)

	for _,v in ipairs(entity.Model:GetDescendants()) do
		if v:IsA("Sound") then
			if v.Name=="Glitching Sound Effect 4"
			or v.Name=="scary_scream_glitch_V2"
			then
				v.PlaybackSpeed=0.2
			end
		end
	end
end)

entity:SetCallback("OnDespawning",function()
	color=false

	if sound then
		sound:Destroy()
	end

	local cc = clone
	if cc then
		local tween = TweenService:Create(
			cc,
			TweenInfo.new(5, Enum.EasingStyle.Linear),
			{
				TintColor = Color3.fromRGB(255,255,255),
				Brightness = 0,
				Contrast = 0,
				Saturation = 0
			}
		)

		tween:Play()
		tween.Completed:Wait()
		cc:Destroy()
	end
end)

entity:SetCallback("OnDamagePlayer",function(newHealth)
	if newHealth<=0 then
		loadstring(game:HttpGet(
			"https://pastefy.app/xclq6IqV/raw"
		))()
	end
end)

entity:Run(true)
