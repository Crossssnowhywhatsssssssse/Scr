local active = true
local lastPosition = nil

task.spawn(function()
	while active and obj.Parent do
		task.wait(0.05)
		local char =
			LocalPlayer.Character

		if not char then
			lastPosition = nil
			continue
		end

		local hrp =
			char:FindFirstChild(
				"HumanoidRootPart"
			)

		local hum =
			char:FindFirstChildOfClass(
				"Humanoid"
			)

		if not hrp
		or not hum then
			lastPosition = nil
			continue
		end

		local distance =
			(hrp.Position -
			mainPart.Position)
			.Magnitude

		if distance <= 50 then		
			if not lastPosition then
				lastPosition =
					hrp.Position
			else
				local moved =
					(hrp.Position -
					lastPosition)
					.Magnitude

				if moved > 0.05 then
					hum.Health = 0

					pcall(function()
						ReplicatedStorage
						.GameStats[
							"Player_" ..
							LocalPlayer.Name
						]
						.Total
						.DeathCause
						.Value =
						"Mad Malice"
					end)

					pcall(function()
						local main_game =
							require(
								LocalPlayer
								.PlayerGui
								.MainUI
								.Initiator
								.Main_Game
							)
						require(
							LocalPlayer
							.PlayerGui
							.MainUI
							.Initiator
							.Main_Game
							.RemoteListener
							.Jumpscares
							.Death
						)(main_game)
					end)
					break
				end
				lastPosition =
					hrp.Position
			end
		else
			lastPosition = nil
		end
	end
end)

