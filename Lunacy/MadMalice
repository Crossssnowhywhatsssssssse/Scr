--------------------------------------------------
-- MOVE
--------------------------------------------------

local SPEED = 35

local function MoveTo(target)
	while obj.Parent do
		local current =
			obj:GetPivot()

		local offset =
			target.Position -
			current.Position

		local distance =
			offset.Magnitude

		if distance <= 0.1 then
			obj:PivotTo(target)
			return
		end

		local dt =
			RunService.Heartbeat:Wait()

		local move =
			SPEED * dt

		if move >= distance then
			obj:PivotTo(target)
			return
		end
		obj:PivotTo(
			current:Lerp(
				target,
				move /
				distance
			)
		)
	end
end

--------------------------------------------------
-- GET NODES
--------------------------------------------------

local function GetNodes(room)
	local nodes = {}
	for _,v in ipairs(
		room:GetDescendants()
	) do

		if v:IsA("BasePart")
		and tonumber(v.Name)
		and (
			v.Parent.Name == "PathfindNode"
			or
			v.Parent.Name == "PathfindNodes"
		) then
			table.insert(
				nodes,
				v
			)
		end
	end

	table.sort(
		nodes,
		function(a,b)
			return
				tonumber(a.Name)
				<
				tonumber(b.Name)
		end
	)
	return nodes
end

