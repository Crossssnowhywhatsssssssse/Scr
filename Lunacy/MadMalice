-- GET ROOMS
--------------------------------------------------

local function GetRooms()
	local rooms = {}

	for _,room in ipairs(
		CurrentRooms:GetChildren()
	) do

		local number =
			tonumber(room.Name)

		if number then
			table.insert(
				rooms,
				room
			)
		end
	end

	table.sort(
		rooms,
		function(a,b)
			return
				tonumber(a.Name)
				<
				tonumber(b.Name)
		end
	)

	return rooms
end

