--------------------------------------------------
-- PATHFIND
--------------------------------------------------

local lastRoomNumber = 0

while obj.Parent do
	local nextRoom = nil
	for _,room in ipairs(
		GetRooms()
	) do

		local num =
			tonumber(room.Name)

		if num
		and num > lastRoomNumber then
			nextRoom = room
			lastRoomNumber = num
			break
		end
	end

	if not nextRoom then
		local added = false
		local connection

		connection =
			CurrentRooms.ChildAdded
			:Connect(function()
				added = true
			end)

		local start = tick()
		while tick() - start < 1 do

			if added then
				break
			end

			RunService.Heartbeat:Wait()
		end

		connection:Disconnect()

		if not added then
			break
		end

		continue
	end
	
	local entrance =
		nextRoom:FindFirstChild(
			"RoomEntrance"
		)

	if entrance then
		MoveTo(
			entrance.CFrame *
			CFrame.new(0,4,0)
		)
	end

	local nodes =
		GetNodes(nextRoom)

	for _,node in ipairs(nodes) do
		MoveTo(
			node.CFrame *
			CFrame.new(0,8,0)
		)
	end

	local exit =
		nextRoom:FindFirstChild(
			"RoomExit"
		)

	if exit then
		MoveTo(
			exit.CFrame *
			CFrame.new(0,4,0)
		)
	end
end

