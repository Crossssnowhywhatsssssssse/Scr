local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local plr = Players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")
local hrp = char:WaitForChild("HumanoidRootPart")

local alive = true
local LatestRoom = ReplicatedStorage.GameData.LatestRoom

-- Spawn
local smile = game:GetObjects("rbxassetid://13194876122")[1]
smile.Parent = workspace

local part = smile:FindFirstChildWhichIsA("BasePart")
if not part then return end

for _, v in ipairs(part:GetDescendants()) do
	if v.Name == "ParticleEmitter" then
	    v.Rate = 100
	    v.Lifetime = NumberRange.new(0.1, 5)
	    v.Color = ColorSequence.new(Color3.new(1,1,1))
	    v.Brightness = 50
	    v.LightEmission = 10000
	    v.Texture = "rbxassetid://101767898481434"
	elseif v.Name == "BlackTrail" then
	    v.Rate = 5000
    	v.Lifetime = NumberRange.new(0.1, 1)
        v.RotSpeed = NumberRange.new(-99999, 99999)
        v.Brightness = 0
    elseif v.Name == "Sparkles" or v.Name == "Att2" then
        v:Destroy()
	end
end

part.CanCollide = false
part.Anchored = true

local function getRoomFloor()
	local room =
		workspace.CurrentRooms:FindFirstChild(
			tostring(math.max(LatestRoom.Value,0))
		)
		
	if room and room:FindFirstChild("RoomEntrance") then
		return room:FindFirstChild("RoomEntrance")
	end
end

local roomentrance = getRoomFloor()
if roomentrance then
	part.CFrame = roomentrance.CFrame * CFrame.new(0, 0, -15)
end

-- Move
local function Move(target)
	local tween = TweenService:Create(
		part,
		TweenInfo.new(
			3,
			Enum.EasingStyle.Linear
		),
		{
			CFrame = target
		}
	)
	tween:Play()
	tween.Completed:Wait()
end

-- Distance damage
task.spawn(function()
	while alive and part.Parent do
		task.wait(0.5)
		local distance = (hrp.Position - part.Position).Magnitude	
		if distance <= 15 and not char:GetAttribute("Hiding") then
			hum:TakeDamage(2)

			ReplicatedStorage.GameStats[
				"Player_"..plr.Name
			].Total.DeathCause.Value =
				"Static Smile"
		end	
	end
end)

-- Follow rooms
task.spawn(function()
	while alive and part.Parent do
		task.wait(3)
		local roomentrance = getRoomFloor()

		if roomentrance then
			Move(
				roomentrance.CFrame * CFrame.new(0, 0, -15)
			)
		end
	end
end)

-- Despawn
local startRoom = LatestRoom.Value

LatestRoom.Changed:Connect(function()
	if LatestRoom.Value >= startRoom + 5 then
		alive = false
		if smile then
			smile:Destroy()
		end
	end
end)
