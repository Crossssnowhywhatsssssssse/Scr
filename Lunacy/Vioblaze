local Workspace = game:GetService("Workspace")

local spawnedFlames = {}
local flameParts = {}

local function CreatePurpleFire(position, parent)
    local flamePart = Instance.new("Part")
    flamePart.Size = Vector3.new(0.2, 0.2, 0.2)
    flamePart.Transparency = 1
    flamePart.Anchored = true
    flamePart.CanCollide = false
    flamePart.CFrame = position
    flamePart.Parent = parent

    local fire = Instance.new("Fire")
    fire.Name = "PurpleFire"
    fire.Color = Color3.fromRGB(150, 0, 255)
    fire.SecondaryColor = Color3.fromRGB(100, 0, 180)
    fire.Size = 3
    fire.Heat = 8
    fire.Parent = flamePart

    table.insert(flameParts, flamePart)
end

local LightFireController = {}

function LightFireController.StartLightFire()
    for _, room in pairs(Workspace.CurrentRooms:GetChildren()) do
        if room:FindFirstChild("Assets") then
            for _, obj in pairs(room.Assets:GetDescendants()) do
                if (obj.Name == "LightStand" or obj.Name == "LightStandSingle") and not spawnedFlames[obj] then
                    local pivot = obj:GetPivot()
                    local parent = obj.Parent
                    CreatePurpleFire(pivot, parent)
                    spawnedFlames[obj] = true
                end
            end
        end
    end
end

function LightFireController.StopLightFire()
    for _, part in pairs(flameParts) do
        if part and part.Parent then part:Destroy() end
    end
    flameParts = {}
    spawnedFlames = {}
end


