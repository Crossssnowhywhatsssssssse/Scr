--// Utils
local function GetCurrentRoom()
	local gd = ReplicatedStorage:FindFirstChild("GameData")
	if not gd then return end

	local lr = gd:FindFirstChild("LatestRoom")
	if not lr then return end

	return workspace.CurrentRooms:FindFirstChild(tostring(lr.Value))
end

local function CameraShake(duration, intensity)

	local start = tick()

	local conn
	conn = RunService.RenderStepped:Connect(function()

		if tick() - start >= duration then
			conn:Disconnect()
			return
		end

		Camera.CFrame =
			Camera.CFrame *
			CFrame.new(
				(math.random()-0.5)*intensity,
				(math.random()-0.5)*intensity,
				0
			)
	end)
end

local function GetAnchorPart(model)

	if model:IsA("BasePart") then
		return model
	end

	for _,v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart") then
			return v
		end
	end
end

local function PlaySound(part,id)

	if not part or not id then
		return
	end

	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = 7
	s.Parent = part

	s:Play()

	Debris:AddItem(s,5)

	return s
end

local function RandomRotation()

	return CFrame.Angles(
		math.rad(math.random(-MaxTiltAngle,MaxTiltAngle)),
		AllowYaw and math.rad(math.random(0,360)) or 0,
		math.rad(math.random(-MaxTiltAngle,MaxTiltAngle))
	)
end

local function AddLight(model)

	local p = GetAnchorPart(model)
	if not p then return end

	local light = Instance.new("PointLight")
	light.Color = LightColor
	light.Range = LightRange
	light.Brightness = LightBrightness
	light.Parent = p
end

local function AddRiseSound(part)

	if not part then return end

	local sound = Instance.new("Sound")
	sound.SoundId = RiseSoundId
	sound.Volume = RiseSoundVolume
	sound.PlaybackSpeed = RiseSoundPlaybackSpeed
	sound.Parent = part

	return sound
end

local function GetRandomFloorCFrame(room)

	local floors = {}

	for _,v in ipairs(room:GetDescendants()) do
		if v:IsA("BasePart")
		and v.Name == "Floor" then
			table.insert(floors,v)
		end
	end

	if #floors <= 0 then
		return
	end

	local floor = floors[math.random(#floors)]
	local size = floor.Size

	return floor.CFrame * CFrame.new(
		(math.random()-0.5)*size.X,
		0,
		(math.random()-0.5)*size.Z
	)
end

local function MoveModelTween(model,anchor,targetCF)

	if not model
	or not model.Parent
	or not anchor then
		return 0
	end

	local offset =
		anchor.CFrame:Inverse()
		* model:GetPivot()

	local startCF = model:GetPivot()
	local endCF = targetCF * offset

	local dist =
		(startCF.Position-endCF.Position).Magnitude

	local time = math.max(dist/MoveSpeed,0.05)

	local cf = Instance.new("CFrameValue")
	cf.Value = startCF

	local conn
	conn = cf:GetPropertyChangedSignal("Value"):Connect(function()

		if model and model.Parent then
			model:PivotTo(cf.Value)
		else
			conn:Disconnect()
		end
	end)

	local tween = TweenService:Create(
		cf,
		TweenInfo.new(time,Enum.EasingStyle.Linear),
		{Value = endCF}
	)

	tween:Play()

	tween.Completed:Once(function()

		conn:Disconnect()
		cf:Destroy()
	end)

	return time
end

--// Room Effects
local function BreakLightsInOpenedRooms()

	local latestRoom =
		ReplicatedStorage.GameData.LatestRoom.Value

	for _,room in ipairs(workspace.CurrentRooms:GetChildren()) do

		local roomId = tonumber(room.Name)

		if roomId and roomId <= latestRoom then

			local fixtures =
				room:FindFirstChild("Assets")
				and room.Assets:FindFirstChild("Light_Fixtures")

			if fixtures then

				for _,obj in ipairs(fixtures:GetDescendants()) do

					if obj:IsA("PointLight")
					or obj:IsA("SurfaceLight")
					or obj:IsA("SpotLight") then

						obj:Destroy()
					end
				end
			end
		end
	end
end

local function ChangeNeonInOpenedRooms()

	local latestRoom =
		ReplicatedStorage.GameData.LatestRoom.Value

	for _,room in ipairs(workspace.CurrentRooms:GetChildren()) do

		local roomId = tonumber(room.Name)

		if roomId and roomId <= latestRoom then

			local fixtures =
				room:FindFirstChild("Assets")
				and room.Assets:FindFirstChild("Light_Fixtures")

			if fixtures then

				for _,fixture in ipairs(fixtures:GetChildren()) do

					local lf = fixture:FindFirstChild("LightFixture")

					if lf then

						local neon = lf:FindFirstChild("Neon")

						if neon then
							neon.Material = Enum.Material.Neon
							neon.Color = NeonColor
						end
					end
				end
			end
		end
	end
end

--// Spawn Closet
local function SpawnRandomObject()

	local room = GetCurrentRoom()
	if not room then return end

	local asset =
		AssetIds[math.random(#AssetIds)]

	local objs = game:GetObjects(asset)

	if not objs or not objs[1] then
		return
	end

	local model = objs[1]
	model.Parent = room

	for _,v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart") then
			v.CanCollide = false
		end
	end

	local anchor = GetAnchorPart(model)

	if not anchor then
		model:Destroy()
		return
	end

	if not model.PrimaryPart then
		model.PrimaryPart = anchor
	end

	local baseCF = GetRandomFloorCFrame(room)

	if not baseCF then
		model:Destroy()
		return
	end

	local _,size = model:GetBoundingBox()
	local rot = RandomRotation()

	local startCF =
		baseCF
		* CFrame.new(0,-(size.Y/2 + RiseDepth),0)
		* rot

	local endCF =
		baseCF
		* CFrame.new(0,(size.Y/2 + ExtraHeight),0)
		* rot

	model:PivotTo(startCF)

	local sound = AddRiseSound(anchor)

	if sound then
		sound:Play()
	end

	local alpha = Instance.new("NumberValue")
	alpha.Value = 0

	local tween = TweenService:Create(
		alpha,
		TweenInfo.new(
			math.random()*(MaxRiseTime-MinRiseTime)+MinRiseTime,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{Value = 1}
	)

	local conn
	conn = RunService.RenderStepped:Connect(function()

		if not model.Parent then
			conn:Disconnect()
			alpha:Destroy()
			return
		end

		model:PivotTo(
			startCF:Lerp(endCF,alpha.Value)
		)
	end)

	tween.Completed:Once(function()

		conn:Disconnect()
		alpha:Destroy()
	end)

	tween:Play()

	AddLight(model)

	table.insert(SpawnedClosets,model)
end

--// Descend
local function DescendCloset(model)

	if not model
	or not model.Parent then
		return
	end

	local anchor = GetAnchorPart(model)
	if not anchor then return end

	local startCF = model:GetPivot()

	local _,size = model:GetBoundingBox()

	local endCF =
		startCF * CFrame.new(
			0,
			-(size.Y + 0.5),
			0
		)

	local sound = Instance.new("Sound")
	sound.SoundId = RiseSoundId
	sound.Volume = RiseSoundVolume
	sound.PlaybackSpeed = RiseSoundPlaybackSpeed
	sound.Parent = anchor
	sound:Play()

	CameraShake(DescendTime,ShakeIntensity)

	local alpha = Instance.new("NumberValue")

	local tween = TweenService:Create(
		alpha,
		TweenInfo.new(
			DescendTime,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		),
		{Value = 1}
	)

	local conn
	conn = RunService.RenderStepped:Connect(function()

		if not model.Parent then
			conn:Disconnect()
			alpha:Destroy()
			return
		end

		model:PivotTo(
			startCF:Lerp(endCF,alpha.Value)
		)
	end)

	tween.Completed:Once(function()

		conn:Disconnect()
		alpha:Destroy()

		if sound then
			sound:Destroy()
		end
	end)

	tween:Play()
end

--// Kill
_G.OnEntityKill = function(entity,player)

	local char =
		LocalPlayer.Character
		or LocalPlayer.CharacterAdded:Wait()

	local hum =
		char:FindFirstChildOfClass("Humanoid")

	local hrp =
		char:FindFirstChild("HumanoidRootPart")

	if hum then
		hum:TakeDamage(5)
	end

	local cue2 = Instance.new("Sound")
	cue2.Parent = workspace
	cue2.Name = "Attacked"
	cue2.SoundId = "rbxassetid://7171761940"
	cue2.Volume = 2
	cue2:Play()

	if hum then

		local animation = Instance.new("Animation")
		animation.AnimationId = "rbxassetid://18759987341"

		local fallen = hum:LoadAnimation(animation)

		fallen:Play()
		fallen.TimePosition = 1
	end

	if hrp then

		local distance = 6
		local speed = 25

		local time = distance/speed

		local backDirection =
			-hrp.CFrame.LookVector * distance

		local targetCFrame =
			hrp.CFrame + backDirection

		local tween = TweenService:Create(
			hrp,
			TweenInfo.new(
				time,
				Enum.EasingStyle.Linear
			),
			{
				CFrame = targetCFrame
			}
		)

		tween:Play()
	end

	pcall(function()

		firesignal(
			ReplicatedStorage.RemotesFolder
			.DeathHint.OnClientEvent,
			{
				"It seems like you just died to The Hiders",
				"They are smart enough to kill 3 people at the same time.",
				"Remember to not let them catch you"
			},
			"Blue"
		)
	end)

	pcall(function()

		ReplicatedStorage
		.GameStats["Player_"..LocalPlayer.Name]
		.Total.DeathCause.Value = "The Hiders"
	end)

	local gui = Instance.new("ScreenGui")
	gui.Name = "Damaged"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.Parent = LocalPlayer.PlayerGui

	local red = Instance.new("ImageLabel")
	red.Name = "Getdamaged"
	red.Size = UDim2.new(1,0,1,0)
	red.BackgroundTransparency = 1
	red.Image = "rbxassetid://74409649836736"
	red.Parent = gui

	task.delay(0.4,function()

		local tw = TweenService:Create(
			red,
			TweenInfo.new(1),
			{
				ImageTransparency = 1
			}
		)

		tw:Play()

		tw.Completed:Once(function()

			if gui then
				gui:Destroy()
			end
		end)
	end)
end

--// Touch
local function SetupKillTouch(model)

	for _,p in ipairs(model:GetDescendants()) do

		if p:IsA("BasePart") then

			p.CanTouch = true

			p.Touched:Connect(function(hit)

				local char =
					hit:FindFirstAncestorOfClass("Model")

				if char == LocalPlayer.Character then

					if _G.OnEntityKill then
						_G.OnEntityKill(model,LocalPlayer)
					end
				end
			end)
		end
	end
end

--// Wander
local function GetWanderPositionNearPlayer(room)

	local char = LocalPlayer.Character
	local hrp =
		char and char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not hrp then
		return
	end

	for _ = 1,10 do

		local angle =
			math.random()*math.pi*2

		local radius =
			math.random(
				FollowRadiusMin,
				FollowRadiusMax
			)

		local offset = Vector3.new(
			math.cos(angle)*radius,
			0,
			math.sin(angle)*radius
		)

		local pos = hrp.Position + offset

		local params = RaycastParams.new()

		params.FilterDescendantsInstances = {char}
		params.FilterType = Enum.RaycastFilterType.Exclude

		local ray = workspace:Raycast(
			pos + Vector3.new(0,10,0),
			Vector3.new(0,-30,0),
			params
		)

		if ray
		and ray.Instance
		and ray.Instance.Name == "Floor" then

			return ray.Position + Vector3.new(0,3,0)
		end
	end
end

local function StartWander(model,anchor,room)

	local running = true

	task.spawn(function()

		while running
		and model
		and model.Parent do

			local pos =
				GetWanderPositionNearPlayer(room)

			if pos then

				local t = MoveModelTween(
					model,
					anchor,
					CFrame.new(pos)
				)

				task.wait(t)

			else
				task.wait(0.2)
			end
		end
	end)

	return function()
		running = false
	end
end

--// Spawn Entity
local function SpawnEntity(cfg,closet,room)

	if not closet
	or not room then
		return
	end

	local objs =
		game:GetObjects(cfg.ModelId)

	if not objs
	or not objs[1] then
		return
	end

	local model = objs[1]
	model.Parent = room

	for _,v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart") then
			v.CanCollide = false
		end
	end

	local anchor = GetAnchorPart(model)

	if not anchor then
		model:Destroy()
		return
	end

	local cPart =
		closet:FindFirstChildWhichIsA(
			"BasePart",
			true
		)

	if not cPart then
		model:Destroy()
		return
	end

	model:PivotTo(
		cPart.CFrame * CFrame.new(0,0,-2)
	)

	PlaySound(anchor,cfg.SpawnSoundId)

	SetupKillTouch(model)

	task.wait(StandStillTime)

	local stop =
		StartWander(model,anchor,room)

	task.wait(WanderTime)

	stop()

	local t = MoveModelTween(
		model,
		anchor,
		cPart.CFrame * CFrame.new(0,0,-2)
	)

	task.wait(t)

	PlaySound(anchor,cfg.DespawnSoundId)

	task.wait(0.3)

	AliveEntities -= 1

	if AliveEntities <= 0 then

		if _G.OnAllEntitiesDespawned then
			_G.OnAllEntitiesDespawned()
		end
	end

	model:Destroy()
end

--// All Despawned
_G.OnAllEntitiesDespawned = function()

	task.delay(DescendDelay,function()

		for _,closet in ipairs(_G.Closets or {}) do

			if closet
			and closet.Parent then

				DescendCloset(closet)
			end
		end
	end)
end

--// Start
CameraShake(ShakeDuration,ShakeIntensity)

ChangeNeonInOpenedRooms()
BreakLightsInOpenedRooms()

for i = 1,SpawnCount do

	SpawnRandomObject()

	task.wait(SpawnDelay)
end

task.delay(0.5,function()
	_G.Closets = SpawnedClosets
end)

task.spawn(function()

	task.wait(StartDelay)

	if not _G.Closets
	or #_G.Closets < 3 then
		return
	end

	local room = GetCurrentRoom()

	if not room then
		return
	end

	for i,cfg in ipairs(Entities) do

		task.delay(cfg.SpawnDelay,function()

			SpawnEntity(
				cfg,
				_G.Closets[i],
				room
			)
		end)
	end
end)
