--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

--// Player
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

--// Config
local AssetIds = {
	"rbxassetid://11205614607",
	"rbxassetid://11205614607",
	"rbxassetid://11205614607",
}

local SpawnCount = 5
local SpawnDelay = 0.05
local ExtraHeight = 0.1

local MaxTiltAngle = 25
local AllowYaw = true

local LightColor = Color3.fromRGB(255,0,0)
local LightRange = 5
local LightBrightness = 3

local NeonColor = Color3.fromRGB(255,0,0)

local MinRiseTime = 1
local MaxRiseTime = 2
local RiseDepth = 6

local ShakeDuration = 2
local ShakeIntensity = 0.15

local RiseSoundId = "rbxassetid://89025651075607"
local RiseSoundVolume = 1.5
local RiseSoundPlaybackSpeed = 1

local MinDistanceBetween = 25

--// Storage
local SpawnedClosets = {}
local UsedPositions = {}

--// Utils
local function GetCurrentRoom()

	local gd = ReplicatedStorage:FindFirstChild("GameData")
	if not gd then return end

	local lr = gd:FindFirstChild("LatestRoom")
	if not lr then return end

	return workspace.CurrentRooms:FindFirstChild(
		tostring(lr.Value)
	)
end

local function CameraShake(duration,intensity)

	local start = tick()

	local conn
	conn = RunService.RenderStepped:Connect(function()

		if tick() - start >= duration then
			conn:Disconnect()
			return
		end

		Camera.CFrame =
			Camera.CFrame *
			CFrame.new(
				(math.random()-0.5)*intensity,
				(math.random()-0.5)*intensity,
				0
			)
	end)
end

local function GetAnchorPart(model)

	if model:IsA("BasePart") then
		return model
	end

	for _,v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart") then
			return v
		end
	end
end

local function PlaySound(part,id)

	if not part or not id then
		return
	end

	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = 7
	s.Parent = part

	s:Play()

	Debris:AddItem(s,5)

	return s
end

local function RandomRotation()

	return CFrame.Angles(
		math.rad(math.random(-MaxTiltAngle,MaxTiltAngle)),
		AllowYaw and math.rad(math.random(0,360)) or 0,
		math.rad(math.random(-MaxTiltAngle,MaxTiltAngle))
	)
end

local function AddLight(model)

	local p = GetAnchorPart(model)
	if not p then return end

	local light = Instance.new("PointLight")
	light.Color = LightColor
	light.Range = LightRange
	light.Brightness = LightBrightness
	light.Parent = p
end

local function AddRiseSound(part)

	if not part then return end

	local sound = Instance.new("Sound")
	sound.SoundId = RiseSoundId
	sound.Volume = RiseSoundVolume
	sound.PlaybackSpeed = RiseSoundPlaybackSpeed
	sound.Parent = part

	return sound
end

local function GetRandomFloorCFrame(room)

	local floors = {}

	for _,v in ipairs(room:GetDescendants()) do
		if v:IsA("BasePart")
		and v.Name == "Floor" then

			table.insert(floors,v)
		end
	end

	if #floors <= 0 then
		return
	end

	for _ = 1,50 do

		local floor = floors[math.random(#floors)]
		local size = floor.Size

		local cf = floor.CFrame * CFrame.new(
			(math.random()-0.5)*size.X,
			0,
			(math.random()-0.5)*size.Z
		)

		local pos = cf.Position
		local valid = true

		for _,oldPos in ipairs(UsedPositions) do

			if (oldPos - pos).Magnitude < MinDistanceBetween then
				valid = false
				break
			end
		end

		if valid then
			table.insert(UsedPositions,pos)
			return cf
		end
	end

	local fallback = floors[math.random(#floors)]

	return fallback.CFrame
end

--// Room Effects
local function BreakLightsInOpenedRooms()

	local latestRoom =
		ReplicatedStorage.GameData.LatestRoom.Value

	for _,room in ipairs(workspace.CurrentRooms:GetChildren()) do

		local roomId = tonumber(room.Name)

		if roomId and roomId <= latestRoom then

			local fixtures =
				room:FindFirstChild("Assets")
				and room.Assets:FindFirstChild("Light_Fixtures")

			if fixtures then

				for _,obj in ipairs(fixtures:GetDescendants()) do

					if obj:IsA("PointLight")
					or obj:IsA("SurfaceLight")
					or obj:IsA("SpotLight") then

						obj:Destroy()
					end
				end
			end
		end
	end
end

local function ChangeNeonInOpenedRooms()

	local latestRoom =
		ReplicatedStorage.GameData.LatestRoom.Value

	for _,room in ipairs(workspace.CurrentRooms:GetChildren()) do

		local roomId = tonumber(room.Name)

		if roomId and roomId <= latestRoom then

			local fixtures =
				room:FindFirstChild("Assets")
				and room.Assets:FindFirstChild("Light_Fixtures")

			if fixtures then

				for _,fixture in ipairs(fixtures:GetChildren()) do

					local lf = fixture:FindFirstChild("LightFixture")

					if lf then

						local neon = lf:FindFirstChild("Neon")

						if neon then
							neon.Material = Enum.Material.Neon
							neon.Color = NeonColor
						end
					end
				end
			end
		end
	end
end

--// Spawn Object
local function SpawnRandomObject()

	local room = GetCurrentRoom()
	if not room then return end

	local asset =
		AssetIds[math.random(#AssetIds)]

	local objs = game:GetObjects(asset)

	if not objs or not objs[1] then
		return
	end

	local model = objs[1]
	model.Parent = room

	for _,v in ipairs(model:GetDescendants()) do

		if v:IsA("BasePart") then
			v.CanCollide = false
		end
	end

	local anchor = GetAnchorPart(model)

	if not anchor then
		model:Destroy()
		return
	end

	if model:IsA("Model")
	and not model.PrimaryPart then

		model.PrimaryPart = anchor
	end

	local baseCF = GetRandomFloorCFrame(room)

	if not baseCF then
		model:Destroy()
		return
	end

	local _,size = model:GetBoundingBox()
	local rot = RandomRotation()

	local startCF =
		baseCF
		* CFrame.new(
			0,
			-(size.Y/2 + RiseDepth),
			0
		)
		* rot

	local endCF =
		baseCF
		* CFrame.new(
			0,
			(size.Y/2 + ExtraHeight),
			0
		)
		* rot

	model:PivotTo(startCF)

	local sound = AddRiseSound(anchor)

	if sound then
		sound:Play()
	end

	local alpha = Instance.new("NumberValue")
	alpha.Value = 0

	local tween = TweenService:Create(
		alpha,
		TweenInfo.new(
			math.random() *
			(MaxRiseTime-MinRiseTime)
			+ MinRiseTime,

			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Value = 1
		}
	)

	local conn
	conn = RunService.RenderStepped:Connect(function()

		if not model.Parent then

			conn:Disconnect()
			alpha:Destroy()

			return
		end

		model:PivotTo(
			startCF:Lerp(
				endCF,
				alpha.Value
			)
		)
	end)

	tween.Completed:Once(function()

		conn:Disconnect()
		alpha:Destroy()
	end)

	tween:Play()

	AddLight(model)

	table.insert(
		SpawnedClosets,
		model
	)
end

--// Start
CameraShake(
	ShakeDuration,
	ShakeIntensity
)

ChangeNeonInOpenedRooms()
BreakLightsInOpenedRooms()

for i = 1,SpawnCount do

	SpawnRandomObject()

	task.wait(SpawnDelay)
end

_G.Closets = SpawnedClosets
