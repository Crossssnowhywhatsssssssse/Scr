local MODEL_ID = "rbxassetid://124072039983366"
local TweenService = game:GetService("TweenService")
local Rooms = workspace:WaitForChild("CurrentRooms")
local player = game.Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

local COUNTDOWN = 15
local DEPTH = 20

local function getRoom()
	local max = -math.huge
	for _, r in ipairs(Rooms:GetChildren()) do
		local n = tonumber(r.Name)
		if n and n > max then max = n end
	end
	return Rooms:FindFirstChild(tostring(max - 1))
end

local function createUI()
	local gui = Instance.new("ScreenGui", PlayerGui)

	local text = Instance.new("TextLabel")
	text.Size = UDim2.new(1,0,0,60)
	text.Position = UDim2.new(0,0,0,5)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.Creepster
	text.TextSize = 32
	text.TextColor3 = Color3.fromRGB(170,0,255)
	text.Parent = gui

	Instance.new("UIStroke", text).Thickness = 2

	local sound = Instance.new("Sound", text)
	sound.SoundId = "rbxassetid://138365271911299"

	return gui, text, sound
end

local function run()
	local room = getRoom()
	if not room then return end

	local exit = room:FindFirstChild("RoomExit", true)
	if not exit then return end

	local blocker = Instance.new("Part")
	blocker.Size = Vector3.new(8,8,8)
	blocker.Anchored = true
	blocker.Transparency = 1
	blocker.CanCollide = true
	blocker.CFrame = exit.CFrame * CFrame.new(0,0,2)
	blocker.Parent = workspace

	local model = game:GetObjects(MODEL_ID)[1]
	model.Parent = workspace

	local pp = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if not pp then return end
	model.PrimaryPart = pp

	for _,v in ipairs(model:GetDescendants()) do
		if v:IsA("BasePart") then
			v.Anchored = true
			v.CanCollide = false
		end
	end

	local baseCF = exit.CFrame
	model:PivotTo(baseCF * CFrame.new(0, -DEPTH, 0))

	TweenService:Create(pp, TweenInfo.new(2), {CFrame = baseCF}):Play()
	task.wait(2)

	local gui, text, sound = createUI()

	for i = COUNTDOWN, 0, -1 do
		text.Text = "Time left: "..i
		
		sound:Stop()
        sound.TimePosition = 0
        sound:Play()

		text.TextSize = 36
		TweenService:Create(text, TweenInfo.new(0.2), {TextSize = 32}):Play()

		task.wait(1)
	end

	TweenService:Create(text, TweenInfo.new(2), {TextTransparency = 1}):Play()
	TweenService:Create(pp, TweenInfo.new(2), {
		CFrame = baseCF * CFrame.new(0, -DEPTH, 0)
	}):Play()

	task.wait(2)

	gui:Destroy()
	model:Destroy()
	blocker:Destroy()
end

run()
