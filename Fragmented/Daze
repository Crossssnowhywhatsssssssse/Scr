local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local function GetCharacter()
	return player.Character or player.CharacterAdded:Wait()
end

local function GetHRP()
	local char = GetCharacter()
	return char and char:FindFirstChild("HumanoidRootPart")
end

local model = game:GetObjects("rbxassetid://14123016442")[1]
if not model then return end

local entity = model:FindFirstChildWhichIsA("BasePart", true)
if not entity then
	model:Destroy()
	return
end

entity.Parent = workspace

local hrp = GetHRP()
if not hrp then
	entity:Destroy()
	return
end

entity.CFrame = hrp.CFrame * CFrame.new(0,0,-7)
entity.Anchored = true
entity.CanCollide = false

local attachment = entity:FindFirstChild("Attachment")
if attachment then
	local face = attachment:FindFirstChild("face")

	if face and face:IsA("ParticleEmitter") then
		face.Rate = 100
		face.Speed = NumberRange.new(5,10)
		face.RotSpeed = NumberRange.new(-180,180)
	end
end

local horrorScream = entity:FindFirstChild("jumpscare")
if horrorScream and horrorScream:IsA("Sound") then
	horrorScream.Volume = 5
end

local active = true
local despawning = false

local function IsLookingAt()
	if not entity.Parent then
		return false
	end

	local direction = entity.Position - camera.CFrame.Position

	if direction.Magnitude <= 0.01 then
		return true
	end

	return direction.Unit:Dot(camera.CFrame.LookVector) > 0.8
end

local function Despawn()
	if despawning then
		return
	end

	despawning = true
	active = false

	if not entity.Parent then
		return
	end

	local tween = TweenService:Create(
		entity,
		TweenInfo.new(5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			CFrame = entity.CFrame * CFrame.new(0,-100,0)
		}
	)

	tween:Play()

	tween.Completed:Once(function()
		if entity and entity.Parent then
			entity:Destroy()
		end
	end)
end

local function Attack()
	if not active then
		return
	end

	active = false

	local char = GetCharacter()
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")

	if horrorScream then
		horrorScream.TimePosition = 0
		horrorScream:Play()
	end

	if not hum or not root then
		Despawn()
		return
	end

	local ATTACK_SPEED = 75

	local attackConn
	attackConn = RunService.Heartbeat:Connect(function(dt)
		if not entity.Parent or not root.Parent then
			attackConn:Disconnect()
			Despawn()
			return
		end

		local dir = root.Position - entity.Position
		local dist = dir.Magnitude

		if dist <= 5 then
			attackConn:Disconnect()

			if hum.Health > 0 then
				hum:TakeDamage(math.random(15,20))

				pcall(function()
					ReplicatedStorage.GameStats["Player_"..player.Name]
						.Total.DeathCause.Value = "Daze"
				end)

				if hum.Health <= 0 then
					pcall(function()
						local main_game = require(
							player.PlayerGui.MainUI.Initiator.Main_Game
						)

						require(
							player.PlayerGui.MainUI.Initiator.Main_Game
							.RemoteListener.Jumpscares.Death
						)(main_game)
					end)
				end
			end

			Despawn()
			return
		end

		local moveDistance = math.min(dist, ATTACK_SPEED * dt)

		entity.CFrame = CFrame.new(
			entity.Position + dir.Unit * moveDistance,
			root.Position
		)
	end)
end

task.delay(3, function()
	if not active or not entity.Parent then
		return
	end

	if not IsLookingAt() then
		Despawn()
		return
	end

	local attackTime = tick() + math.random(3,5)

	local conn
	conn = RunService.Heartbeat:Connect(function()
		if not active or not entity.Parent then
			conn:Disconnect()
			return
		end

		if not IsLookingAt() then
			conn:Disconnect()
			Despawn()
			return
		end

		if tick() >= attackTime then
			conn:Disconnect()
			Attack()
		end
	end)
end)
