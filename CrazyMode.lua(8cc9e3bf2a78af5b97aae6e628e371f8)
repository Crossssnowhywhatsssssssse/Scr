function LoadCustomInstance(source)
	local model

	-- Normalize GitHub URL if needed
	local function NormalizeGitHubURL(url)
		if url:match("^https://github.com/.+%.rbxm$") and not url:find("?raw=true") then
			return url .. "?raw=true"
		end
		return url
	end

	while task.wait() and not model do
		if type(source) == "number" or tostring(source):match("^%d+$") then
			-- Asset ID loading
			local success, result = pcall(function()
				return game:GetObjects("rbxassetid://" .. tostring(source))[1]
			end)

			if success and result then
				model = result
			end

		elseif type(source) == "string" and source:match("^https?://") and source:match("%.rbxm") then
			-- GitHub URL loading
			local url = NormalizeGitHubURL(source)
			
			local success, result = pcall(function()
				local fileName = "temp_" .. tostring(math.random(100000, 999999)) .. ".rbxm"
				writefile(fileName, game:HttpGet(url))
				local obj = game:GetObjects((getcustomasset or getsynasset)(fileName))[1]
				delfile(fileName)
				return obj
			end)

			if success and result then
				model = result
			end
		else
		        break
		end

		if model then

			for _, obj in ipairs(model:GetDescendants()) do
				if obj:IsA("Script") or obj:IsA("LocalScript") then
					obj:Destroy()
				end
			end

			pcall(function()
				model:SetAttribute("LoadedByExecutor", true)
			end)
		end
	end

	return model
end


local LightReplaceModel = LoadCustomInstance("https://github.com/Whatttt23/Scr/raw/main/Light.rbxm")

local function IsPositionClear(cframe, size, ignoreList)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = ignoreList or {}

	local parts = workspace:GetPartBoundsInBox(cframe, size, params)
	return #parts == 0
end

local function FindNearbyClearCFrame(baseCFrame, model, ignoreList)
	local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if not primary then
		return baseCFrame
	end

	local size = model:GetExtentsSize()

	local offsets = {
		Vector3.new(0, 0, 0),
		Vector3.new(2, 0, 0),
		Vector3.new(-2, 0, 0),
		Vector3.new(0, 0, 2),
		Vector3.new(0, 0, -2),
		Vector3.new(0, 2, 0),
		Vector3.new(3, 0, 3),
		Vector3.new(-3, 0, -3),
	}

	for _,offset in ipairs(offsets) do
		local cf = baseCFrame * CFrame.new(offset)
		if IsPositionClear(cf, size, ignoreList) then
			return cf
		end
	end

	return baseCFrame
end

local function lights()
    local room = workspace.CurrentRooms[
        game.ReplicatedStorage.GameData.LatestRoom.Value
    ]

    local fixtures = room.Assets.Light_Fixtures
    local targets = {}

    for _,v in ipairs(fixtures:GetDescendants()) do
        if v.Name == "LightStand" or v.Name == "LightStandSingle" then
            table.insert(targets, v)
        end
    end

    for _,v in ipairs(targets) do
        local torch = LightReplaceModel:Clone()
        torch.Name = "Torch"
        torch.Parent = room.Assets
        torch:PivotTo(v:GetPivot() * CFrame.new(2, -6, 3))
        local baseCFrame = v:GetPivot() * CFrame.new(2, -6, 3)

        local finalCFrame = FindNearbyClearCFrame(
			baseCFrame,
			torch,
			{room, torch, fixtures}
		)

		torch:PivotTo(finalCFrame)
        torch.PivotPoint:Destroy()
        
    end

    fixtures:Destroy()
end

