---====== Debug entity ======---

entity:SetCallback("OnSpawned", function()
    local model = entity.Model
    local part = model.PrimaryPart
    local sound = Instance.new("Sound", part)
         sound.SoundId = "rbxassetid://80345507609839"
         sound.Volume = 0.4
         sound.RollOffMinDistance = 100
         sound.RollOffMaxDistance = 150
         sound.PlaybackSpeed = 0.3
         sound.Looped = true
         sound:Play()
    local a = sound:Clone()
         a.Parent = part
         a.SoundId = "rbxassetid://127751543523558"
         a.Volume = 1
         a.RollOffMinDistance = 50
         a.RollOffMaxDistance = 70
         a.PlaybackSpeed = 0.3
         a.Looped = true
         a:Play()
end)

entity:SetCallback("OnDespawning", function()
    local model = entity.Model
    game.TweenService:Create(SmileColor, TweenInfo.new(5), {
    TintColor = Color3.fromRGB(255, 255, 255),
    Saturation = 0,
    Contrast = 0
    }):Play()
    wait(5)
    cue2:Destroy()
    SmileColor:Destroy()
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
	if newHealth == 0 then
		local main_game = require(game:GetService("Players").LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game)
		require(game:GetService("Players").LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game.RemoteListener.Jumpscares.Death)(main_game)
	end
end)

---====== Run entity ======---

entity:Run()
